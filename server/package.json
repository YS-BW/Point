    "t2": "node test/02-restart-continue.mjs",
    "t3": "node test/03-stop-semantics.mjs",
    "t4": "node test/04-ui-contract.mjs",
    "test": "node test/run-all.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "typebox": "1.4.0"
  }
